#!/usr/bin/env bash
# Pre-commit hook: style check, Android Lint and JVM unit tests
# (no devices needed). Enable once per clone with:
#   git config core.hooksPath hooks
set -e
cd "$(git rev-parse --show-toplevel)/android-app"
echo "pre-commit: running ktlint, lint and unit tests..."
./gradlew :app:ktlintCheck :app:lintDebug :app:testDebugUnitTest -q
echo "pre-commit: all checks passed"
